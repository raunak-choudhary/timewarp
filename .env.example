# TimeWarp environment variables.
# Copy this file to .env and fill in your own values.

# Supabase, used as the checkpoint store.
# Get these from your project settings at supabase.com.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-anon-key-here

# Anthropic, used by the demo agent for its LLM calls.
# Get this from console.anthropic.com.
ANTHROPIC_API_KEY=your-anthropic-api-key

# Cosine similarity below this value counts as semantic drift.
DRIFT_THRESHOLD=0.72
