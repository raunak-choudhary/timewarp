# TimeWarp — Environment Variables
# Copy this file to .env and fill in all values before starting Phase 0

# === Supabase ===
# Get from: https://supabase.com/dashboard/project/<your-project>/settings/api
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-anon-key-here

# === Anthropic (for demo agent LLM calls) ===
# Get from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-api03-...

# === Azure (for Phase 4 deployment) ===
# Get from: https://portal.azure.com
AZURE_SUBSCRIPTION_ID=your-subscription-id
AZURE_RESOURCE_GROUP=timewarp-rg
AZURE_LOCATION=eastus

# === TimeWarp Core Config (defaults are fine for hackathon) ===
DRIFT_THRESHOLD=0.72
CHECKPOINT_INTERVAL_MS=100
SEGMENT_TREE_MAX_DEPTH=256
EMBEDDING_MODEL=all-MiniLM-L6-v2

# === Server ===
HOST=0.0.0.0
PORT=8000
DEBUG=true
